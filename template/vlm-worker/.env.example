VLM_WORKER_SECRET=replace-with-a-random-secret-at-least-16-characters
VLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-provider-key
OPENAI_VLM_MODEL=gpt-4o
# For Gemini, use VLM_PROVIDER=gemini and set GEMINI_API_KEY and GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
# Add an exact private S3-compatible hostname only when the bucket uses a custom endpoint.
VLM_ALLOWED_IMAGE_HOSTS=
VLM_SHARPNESS_THRESHOLD=100
